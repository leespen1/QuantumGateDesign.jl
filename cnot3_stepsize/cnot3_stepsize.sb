#!/bin/bash --login
#SBATCH --job-name=cnot3_stepsize  # Job name
#SBATCH --mail-type=NONE             # Mail events (NONE, BEGIN, END, FAIL, ALL)
#SBATCH --mail-user=leespen1@msu.edu # Where to send mail. 
#SBATCH --nodes=1                    # Maximum number of nodes to be allocated
#SBATCH --ntasks-per-node=1          # Maximum number of tasks on each node
#SBATCH --cpus-per-task=4            # Number of processors for each task (want several because the BLAS is multithreaded, even though my Julia code is not)
#SBATCH --mem=32G                    # Memory (i.e. RAM) per NODE
#SBATCH --export=NONE                 # HPCC suggests setting to NONE for HPCC reasons, but I don't think it's necessary, and I want ALL so that I can load julia and have it transfer to all nodes
#SBATCH --constraint=intel18         # Run on the
#SBATCH --time=01:30:00                           # Wall time limit (days-hrs:min:sec)
#SBATCH --output=cnot3_stepsize_%A_%a.log     # Path to the standard output and error files relative to the working directory
#SBATCH --array=0-11

# We get about 56 GB of RAM on the dev nodes. But also, I think it is better to
# keep things to one test per node so I don't have competition for memory (e.g.
# if one order uses up memory faster than the other)

echo "Date              = $(date)"
echo "Hostname          = $(hostname -s)"
echo "Working Directory = $(pwd)"
echo ""
echo "Number of Nodes Allocated      = $SLURM_JOB_NUM_NODES"
echo "Number of Tasks Per Node       = $SLURM_NTASKS_PER_NODE"
echo "Number of CPUs Per Task        = $SLURM_CPUS_PER_TASK"
echo "Memory per node                = $SLURM_MEM_PER_NODE"
echo ""

module purge

# Define the options for arg1 and arg2
METHOD_ORDERS=(2 4 6 8 10 12)
NUM_SEEDS=2

# Calculate the indices for this task
METHOD_ORDER_INDEX=$(( SLURM_ARRAY_TASK_ID / NUM_SEEDS ))
METHOD_ORDER=${METHOD_ORDERS[$METHOD_ORDER_INDEX]}
SEED=$(( SLURM_ARRAY_TASK_ID % NUM_SEEDS ))

TIME=1

D1=15
RTOL=1e-12

PROJECTENV=/mnt/home/leespen1/Research/QuantumGateDesign.jl
#julia --project=$PROJECTENV -e 'using Pkg; Pkg.instantiate()' # Set up project enviornment

# To avoid Pkg errors
unset LD_LIBRARY_PATH

CMD_STRING="julia --project=$PROJECTENV --threads=$SLURM_CPUS_PER_TASK ./cnot3_stepsize.jl $METHOD_ORDER $SEED --time $TIME --D1 $D1 --rtol $RTOL"
echo $CMD_STRING
$CMD_STRING
