#!/bin/bash --login
#SBATCH --job-name=cnot3_stepsize  # Job name
#SBATCH --mail-type=NONE             # Mail events (NONE, BEGIN, END, FAIL, ALL)
#SBATCH --mail-user=leespen1@msu.edu # Where to send mail. 
#SBATCH --nodes=1                    # Maximum number of nodes to be allocated
#SBATCH --ntasks-per-node=1          # Maximum number of tasks on each node
#SBATCH --cpus-per-task=1            # Number of processors for each task (want several because the BLAS is multithreaded, even though my Julia code is not)
#SBATCH --mem=32G                    # Memory (i.e. RAM) per NODE
#SBATCH --export=NONE                 # HPCC suggests setting to NONE for HPCC reasons, but I don't think it's necessary, and I want ALL so that I can load julia and have it transfer to all nodes
#SBATCH --constraint=intel18         # Run on the
#SBATCH --time=03:59:00                           # Wall time limit (days-hrs:min:sec)
#SBATCH --output=%A/cnot3_stepsize_%A_%a.log     # Path to the standard output and error files relative to the working directory
#SBATCH --array=0-149 # 25 jobs each, for 6 orders order

# We get about 56 GB of RAM on the dev nodes. But also, I think it is better to
# keep things to one test per node so I don't have competition for memory (e.g.
# if one order uses up memory faster than the other)

# Create directory where we will store the logs (and the data)
mkdir -p $SLURM_ARRAY_JOB_ID

echo "Date              = $(date)"
echo "Hostname          = $(hostname -s)"
echo "Working Directory = $(pwd)"
echo ""
echo "Number of Nodes Allocated      = $SLURM_JOB_NUM_NODES"
echo "Number of Tasks Per Node       = $SLURM_NTASKS_PER_NODE"
echo "Number of CPUs Per Task        = $SLURM_CPUS_PER_TASK"
echo "Memory per node                = $SLURM_MEM_PER_NODE"
echo ""

# Define the options for arg1 and arg2
METHOD_ORDERS=(2 4 6 8 10 12)
NUM_ORDERS=${#METHOD_ORDERS[@]}

TIME=3.75

DEGREE=14
D1=16
RTOL=1e-15
ATOL=1e-15
USE_JUQBOX=false
GRADIENT=true
LEVELS_CAVITY=10
START_IN_HIGHEST_STATE=true
SEEDOFFSET=0

# To avoid Pkg errors
unset LD_LIBRARY_PATH


if [[ -n "$SLURM_JOB_ID" ]]; then
    echo "You are in a SLURM environment. Using job array id to run script."
    echo "SLURM Job ID: $SLURM_JOB_ID"

    module purge

    # Set up project environment, if needed (may not be instantiated)
    INSTANTIATE_STRING="julia --project -e 'using Pkg; Pkg.instantiate()'"
    echo $INSTANTIATE_STRING 
    eval $INSTANTIATE_STRING

    # Calculate the indices for this task
    SEED=$(( (SLURM_ARRAY_TASK_ID / NUM_ORDERS) + SEEDOFFSET ))
    METHOD_ORDER_INDEX=$(( SLURM_ARRAY_TASK_ID % NUM_ORDERS ))
    METHOD_ORDER=${METHOD_ORDERS[$METHOD_ORDER_INDEX]}

    OUTPUTDIR="$SLURM_ARRAY_JOB_ID"
    NTHREADS=$SLURM_CPUS_PER_TASK

    CMD_STRING="julia --project --threads=$NTHREADS ./cnot3_stepsize.jl $METHOD_ORDER $DEGREE $SEED --time $TIME --D1 $D1 --rtol $RTOL --atol $ATOL --use_juqbox $USE_JUQBOX --gradient $GRADIENT --output_directory=$OUTPUTDIR --levels_cavity $LEVELS_CAVITY --start_in_highest_state $START_IN_HIGHEST_STATE"
    echo $CMD_STRING
    eval $CMD_STRING
else
    echo "You are not in a SLURM environment. Running script over a loop."

    OUTPUTDIR="$RANDOM"
    NTHREADS=4

    # Set up project environment, if needed
    INSTANTIATE_STRING="julia --project -e 'using Pkg; Pkg.instantiate()'"
    echo $INSTANTIATE_STRING
    eval $INSTANTIATE_STRING

    for SLURM_ARRAY_TASK_ID in {0..11} # Replace SLURM_ARRAY_TASK_ID with my own loop
    do
        SEED=$(( (SLURM_ARRAY_TASK_ID / NUM_ORDERS) + SEEDOFFSET ))
        METHOD_ORDER_INDEX=$(( SLURM_ARRAY_TASK_ID % NUM_ORDERS ))
        METHOD_ORDER=${METHOD_ORDERS[$METHOD_ORDER_INDEX]}

        CMD_STRING="julia --project --threads=$NTHREADS ./cnot3_stepsize.jl $METHOD_ORDER $DEGREE $SEED --time $TIME --D1 $D1 --rtol $RTOL --atol $ATOL --use_juqbox $USE_JUQBOX --gradient $GRADIENT --output_directory=$OUTPUTDIR --levels_cavity $LEVELS_CAVITY --start_in_highest_state $START_IN_HIGHEST_STATE"
        echo $CMD_STRING
        eval $CMD_STRING
    done
fi
